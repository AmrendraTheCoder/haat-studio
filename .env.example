# The one config file. Copy to .env and fill in. Next.js and every script read it.

# Free Hugging Face token (read access is enough): https://huggingface.co/settings/tokens
# Required: the FASHN Space refuses anonymous API calls ("exceeded your ZeroGPU runs limit").
# A free account gets a few minutes of GPU time per day — roughly a handful of try-ons.
HF_TOKEN=

# Engines to try, in order, comma-separated. Only fashn-space exists so far.
TRYON_ENGINES=fashn-space

# Give up on one generation after this long, queue included.
TRYON_TIMEOUT_MS=240000

# Where generated results are kept (one folder per result).
DATA_DIR=data

# Your Hugging Face account's daily ZeroGPU allowance, for the "free GPU today"
# meter: 300 seconds on a free account, 2400 on PRO. Free accounts also have an
# unpublished daily limit on the number of photos; the studio learns it the first
# time Hugging Face refuses with "runs limit", or set it here if you know it.
# ZEROGPU_DAILY_SECONDS=300
# ZEROGPU_DAILY_RUNS=

# Show "Feature on the home page" in the studio. Defaults to on in development
# and off in production builds, since there is no login yet.
CURATION=

# Testing only: TRYON_ENGINES=echo runs a fake engine that returns the model
# photo unchanged (no try-on), so the UI can be exercised without a GPU.
# ECHO_FAIL=quota or ECHO_FAIL=error simulates failures. Use a throwaway DATA_DIR.

# Text AI for captions and market research (Phases 4–5). Free, no card. Any one is enough.
# Without one, captions and research are clearly labelled templates built from your own words.
# Groq: https://console.groq.com/keys   Google AI Studio: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Order to try them in. `npm run llm:check` shows which answer.
LLM_CHAIN=groq/llama-3.3-70b-versatile,gemini/gemini-2.5-flash

# Required on any public deployment: creating anything needs this passcode.
STUDIO_PASSCODE=
