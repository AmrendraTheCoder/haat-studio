# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# haat-studio: generated results, downloaded example photos, eval output
/data/
/public/presets/
/public/samples/
/eval/reports/

# BTP report: photos and build output are not committed (see "Don't commit photos")
/docs/btp-report/figures/*.jpg
/docs/btp-report/report.filled.html
/docs/btp-report/figures/team/
/docs/mini-project-report/generated/
/docs/mini-project-report/main.pdf
/analysis/results/

# retail catalogue (scraped listings + ~82k photos): local only
/retail/
# app screenshots contain model photos (see "Don't commit photos")
/docs/btp-report/figures/ui/

# python bytecode
__pycache__/
*.pyc
